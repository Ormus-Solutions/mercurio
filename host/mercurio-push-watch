#!/usr/bin/env python3
"""Wake Mercurio when a Herdr agent needs you.

Follows the event stream of every running Herdr session over its API socket,
and looks for new sessions every few seconds (--session NAME follows just that
one). When a pane's agent turns blocked (and, with --states blocked,done, done),
it POSTs a small JSON message, naming the session, to every push endpoint in the
endpoints file. The phone's
UnifiedPush distributor (the ntfy app) delivers it and wakes Mercurio, which
then reads the pane over SSH itself. The message never carries pane text.

Endpoints file: ${XDG_CONFIG_HOME:-~/.config}/mercurio/push-endpoints, one URL
per line, '#' comments allowed. It is read again on every push, so the app can
add or replace its URL without a restart. See docs/PUSH.md.

Python 3 standard library only.
"""

from __future__ import annotations

import argparse
import json
import os
import signal
import socket
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request
from collections.abc import Callable, Iterable
from urllib.parse import urlsplit

# Herdr only streams agent status per pane id (and refuses a subscription that
# names a closed pane), so any of these events means: snapshot and resubscribe.
STRUCTURE_EVENTS = ("pane.created", "pane.closed")
MAX_BACKOFF = 60.0
# How often to look for Herdr sessions that started since the last look.
RESCAN = 15.0


def log(message: str) -> None:
    print(message, file=sys.stderr, flush=True)


def config_home() -> str:
    return os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")


def herdr_socket(session: str | None) -> str:
    """Same lookup Herdr uses: named sessions live under herdr/sessions/<name>."""
    base = os.path.join(config_home(), "herdr")
    if session and session != "default":
        return os.path.join(base, "sessions", session, "herdr.sock")
    return os.environ.get("HERDR_SOCKET_PATH") or os.path.join(base, "herdr.sock")


def herdr_sessions() -> dict[str, str]:
    """Every Herdr session with a socket, by name: the default one and herdr/sessions/*."""
    found = {}
    default = herdr_socket(None)
    if os.path.exists(default):
        found["default"] = default
    sessions = os.path.join(config_home(), "herdr", "sessions")
    names = sorted(os.listdir(sessions)) if os.path.isdir(sessions) else []
    for name in names:
        sock = herdr_socket(name)
        if os.path.exists(sock):
            found[name] = sock
    return found


def running(sock_path: str) -> bool:
    """A stopped session can leave its socket file behind; only a live server accepts."""
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(2)
            s.connect(sock_path)
        return True
    except OSError:
        return False


def read_endpoints(path: str) -> list[str]:
    try:
        with open(path, encoding="utf-8") as f:
            lines = [line.strip() for line in f]
    except FileNotFoundError:
        return []
    return [u for u in lines if u and not u.startswith("#") and urlsplit(u).scheme in ("http", "https")]


def post_json(url: str, body: bytes, timeout: float = 5.0) -> int:
    req = urllib.request.Request(url, data=body, method="POST", headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return resp.status


def send(endpoints_path: str, message: dict, post: Callable[[str, bytes], int], what: str) -> None:
    """POST [message] to every endpoint in the file; a failing endpoint does not stop the others."""
    endpoints = read_endpoints(endpoints_path)
    if not endpoints:
        log(f"{what}: no endpoints in {endpoints_path}")
        return
    body = json.dumps(message, separators=(",", ":")).encode()
    for url in endpoints:
        where = urlsplit(url).netloc
        try:
            code = post(url, body)
            log(f"{what}: pushed to {where} ({code})")
        except Exception as e:  # a bad endpoint must not stop the others, or the watcher
            log(f"{what}: push to {where} failed: {e}")


def herdr_request(sock_path: str, method: str, params: dict) -> dict:
    """One request per connection, as Herdr's API socket expects."""
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.settimeout(10)
        s.connect(sock_path)
        s.sendall((json.dumps({"id": "push-watch", "method": method, "params": params}) + "\n").encode())
        line = s.makefile(encoding="utf-8").readline()
    reply = json.loads(line)
    if "error" in reply:
        raise RuntimeError(f"{method}: {reply['error'].get('code')}")
    return reply["result"]


class Watcher:
    def __init__(
        self,
        sock_path: str,
        session: str,
        host: str,
        states: Iterable[str],
        debounce: float,
        endpoints_path: str,
        post: Callable[[str, bytes], int] = post_json,
        clock: Callable[[], float] = time.monotonic,
    ) -> None:
        self.sock_path = sock_path
        self.session = session
        self.host = host
        self.states = set(states)
        self.debounce = debounce
        self.endpoints_path = endpoints_path
        self.post = post
        self.clock = clock
        self.status: dict[str, str] = {}
        self.agent: dict[str, str | None] = {}
        self.last_push: dict[str, float] = {}
        self.synced = False
        self.down = False
        self.backoff = 1.0

    def snapshot(self) -> dict:
        return herdr_request(self.sock_path, "session.snapshot", {})["snapshot"]

    def observe(self, pane_id: str, status: str, agent: str | None, notify: bool = True) -> None:
        previous = self.status.get(pane_id)
        self.status[pane_id] = status
        if agent:
            self.agent[pane_id] = agent
        if not notify or status == previous or status not in self.states:
            return
        now = self.clock()
        last = self.last_push.get(pane_id)
        if last is not None and now - last < self.debounce:
            log(f"{pane_id} {status}: debounced")
            return
        self.last_push[pane_id] = now
        self.push(pane_id, status)

    def payload(self, pane_id: str, status: str) -> dict:
        message = {
            "v": 1,
            "event": "pane.agent_status_changed",
            "state": status,
            "host": self.host,
            "session": self.session,
            "pane_id": pane_id,
            "agent": self.agent.get(pane_id),
            "workspace_id": None,
            "workspace": None,
            "tab_id": None,
            "tab": None,
            "ts": int(time.time()),
        }
        try:
            snap = self.snapshot()
        except (OSError, ValueError, RuntimeError):
            return message
        pane = next((p for p in snap.get("panes", []) if p.get("pane_id") == pane_id), None)
        if pane:
            message["workspace_id"] = pane.get("workspace_id")
            message["tab_id"] = pane.get("tab_id")
            message["agent"] = pane.get("agent") or message["agent"]
        for w in snap.get("workspaces", []):
            if w.get("workspace_id") == message["workspace_id"]:
                message["workspace"] = w.get("label")
        for t in snap.get("tabs", []):
            if t.get("tab_id") == message["tab_id"]:
                message["tab"] = t.get("label")
        return message

    def push(self, pane_id: str, status: str) -> None:
        send(self.endpoints_path, self.payload(pane_id, status), self.post, f"{pane_id} {status}")

    def apply_snapshot(self, snap: dict) -> set[str]:
        panes = snap.get("panes", [])
        for p in panes:
            self.observe(p["pane_id"], p.get("agent_status", "unknown"), p.get("agent"), notify=self.synced)
        ids = {p["pane_id"] for p in panes}
        for gone in set(self.status) - ids:
            self.status.pop(gone, None)
            self.agent.pop(gone, None)
            self.last_push.pop(gone, None)
        return ids

    def follow(self) -> None:
        """Subscribe, sync, then read events until the pane set changes or Herdr goes away."""
        ids = sorted(p["pane_id"] for p in self.snapshot().get("panes", []))
        subs = [{"type": t} for t in STRUCTURE_EVENTS]
        subs += [{"type": "pane.agent_status_changed", "pane_id": i} for i in ids]
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.connect(self.sock_path)
            s.sendall(
                (
                    json.dumps({"id": "push-watch", "method": "events.subscribe", "params": {"subscriptions": subs}})
                    + "\n"
                ).encode()
            )
            stream = s.makefile(encoding="utf-8")
            started = json.loads(stream.readline() or "{}")
            if started.get("result", {}).get("type") != "subscription_started":
                raise RuntimeError(f"subscribe: {started.get('error', {}).get('code', 'closed')}")
            self.backoff = 1.0
            if self.down:
                log("herdr is back")
                self.down = False
            # A change between the first snapshot and the subscribe shows up here.
            if self.apply_snapshot(self.snapshot()) != set(ids):
                self.synced = True
                return
            if not self.synced:
                log(f"watching {len(ids)} panes on {self.sock_path}")
            self.synced = True
            for line in stream:
                event = json.loads(line)
                if event.get("event") == "pane.agent_status_changed":
                    d = event.get("data", {})
                    self.observe(d.get("pane_id", ""), d.get("agent_status", "unknown"), d.get("agent"))
                else:
                    return  # pane created or closed: resubscribe with the new set
        raise ConnectionError("herdr closed the event stream")

    def run(self) -> int:
        while True:
            # A deleted session takes its directory with it; a stopped one is retried.
            if not os.path.isdir(os.path.dirname(self.sock_path)):
                log(f"no Herdr here ({os.path.dirname(self.sock_path)} missing); nothing to watch")
                return 0
            try:
                self.follow()
            except (OSError, ValueError, RuntimeError) as e:
                if not self.down:
                    log(f"herdr unavailable ({e}); retrying with backoff")
                    self.down = True
                time.sleep(self.backoff)
                self.backoff = min(self.backoff * 2, MAX_BACKOFF)


# --- herdr-core -------------------------------------------------------------
# `hc events --json` prints the snapshot object ({"seq":..,"terminals":[..]}), then one JSON-RPC
# notification per line: "event" (created, status, turn, labels, removed, ...), "heartbeat" every
# 15 s, and "missed" with a fresh snapshot when this reader fell behind. Formats measured on core 0.1.20.

CORE_SESSION = "@core"
CORE_COMMAND = ("hc", "events", "--json")
# The words a core status may give for why it blocks.
CORE_KINDS = ("permission", "question", "auth")
AGENT_MAX = 64
# A heartbeat comes every 15 s; three missing ones mean the pipe is open and nobody is writing.
CORE_STALL = 45.0
# How long a block waits for the `turn` event that follows its status (the phone guards Approve on it).
CORE_SETTLE = 1.0
# How long a finish waits for the desktop app to mark it seen (label herdr.seen) before it counts as unseen.
CORE_SEEN_GRACE = 3.0
BUSY = ("working", "blocked", "error")
NEEDS = ("blocked", "error")


def whole(x: object) -> bool:
    return isinstance(x, int) and not isinstance(x, bool)


def core_alert(prev: str | None, new: str | None) -> str | None:
    """The desktop app's rule (herdr-app model.rs `alert`) for a change of status word, before the seen check:
    needing you always alerts; going from busy to not busy is a finish."""
    if new in NEEDS and prev not in NEEDS:
        return "blocked"
    if prev in BUSY and new is not None and new not in BUSY:
        return "done"
    return None


def hc_lines(command: Iterable[str] = CORE_COMMAND, stall: float = CORE_STALL) -> Iterable[str]:
    """Lines of a command's output; the command is killed when it goes quiet for [stall] seconds."""
    proc = subprocess.Popen(
        list(command), stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, encoding="utf-8", errors="replace"
    )
    last = [time.monotonic()]
    over = threading.Event()

    def watchdog() -> None:
        while not over.wait(min(stall / 2, 5.0)):
            if time.monotonic() - last[0] > stall:
                proc.kill()
                return

    threading.Thread(target=watchdog, daemon=True).start()
    try:
        assert proc.stdout is not None
        for line in proc.stdout:
            last[0] = time.monotonic()
            yield line
    finally:
        over.set()
        proc.kill()
        proc.wait()


def after(delay: float, fn: Callable[[], None]) -> None:
    t = threading.Timer(delay, fn)
    t.daemon = True
    t.start()


class CoreWatcher:
    """Follows herdr-core's event stream and pushes when a core agent needs the person.

    Same rule as the desktop app: blocked always alerts, a finish alerts only if nobody looked (the shared
    label herdr.seen is not at the turn), and a helper (a terminal with a parent) never does. The message
    carries ids and labels only (address, agent kind, why it blocks, turn, space and tab names), never the
    screen, the title or the status message: the phone reads the question itself.
    """

    def __init__(
        self,
        host: str,
        endpoints_path: str,
        debounce: float,
        post: Callable[[str, bytes], int] = post_json,
        clock: Callable[[], float] = time.monotonic,
        spawn: Callable[[], Iterable[str]] | None = None,
        schedule: Callable[[float, Callable[[], None]], None] = after,
        sleep: Callable[[float], None] = time.sleep,
        settle: float = CORE_SETTLE,
        seen_grace: float = CORE_SEEN_GRACE,
    ) -> None:
        self.host = host
        self.endpoints_path = endpoints_path
        self.debounce = debounce
        self.post = post
        self.clock = clock
        self.spawn = spawn or (lambda: hc_lines())
        self.schedule = schedule
        self.sleep = sleep
        self.settle = settle
        self.seen_grace = seen_grace
        self.terms: dict[str, dict] = {}
        self.pending: dict[str, dict] = {}
        self.last_push: dict[tuple[str, str, int], float] = {}
        self.floor = -1
        self.synced = False
        self.snapshots = 0
        self.token = 0
        self.lock = threading.RLock()
        self.outbox: list[tuple[dict, str]] = []

    # -- reading the stream

    def run(self) -> int:
        backoff = 1.0
        down = False
        while True:
            self.floor = -1
            before = self.snapshots
            try:
                self.consume(self.spawn())
                reason = "hc exited"
            except (KeyboardInterrupt, SystemExit):
                raise
            except Exception as e:  # a surprise in the stream must not end the watcher: start over
                reason = f"{type(e).__name__}: {e}"
            if self.snapshots > before:
                backoff = 1.0
                down = False
            if not down:
                log(f"herdr-core unavailable ({reason}); retrying with backoff")
                down = True
            self.sleep(backoff)
            backoff = min(backoff * 2, MAX_BACKOFF)

    def consume(self, lines: Iterable[str]) -> None:
        try:
            for line in lines:
                self.handle(line)
        finally:
            close = getattr(lines, "close", None)
            if close:
                close()

    def handle(self, line: str) -> None:
        try:
            msg = json.loads(line)
        except ValueError:
            return
        if not isinstance(msg, dict):
            return
        params = msg.get("params")
        params = params if isinstance(params, dict) else {}
        with self.lock:
            method = msg.get("method")
            if method is None and isinstance(msg.get("terminals"), list):
                self.sync(msg["terminals"], msg.get("seq"))
                self.snapshots += 1
            elif method == "missed" and isinstance(params.get("terminals"), list):
                self.sync(params["terminals"], params.get("seq"))
            elif method == "event":
                self.apply(params)
        self.flush()

    def flush(self) -> None:
        """POST what the last step decided, outside the lock: an endpoint may take 5 s and the reader must not wait."""
        with self.lock:
            out, self.outbox = self.outbox, []
        for message, what in out:
            send(self.endpoints_path, message, self.post, what)

    def timed(self, addr: str, token: int) -> None:
        self.fire(addr, token)
        self.flush()

    def record(self, t: dict) -> dict:
        status = t.get("status") if isinstance(t.get("status"), dict) else {}
        labels = t.get("labels") if isinstance(t.get("labels"), dict) else {}
        return {
            "parent": t.get("parent"),
            "labels": labels,
            "word": status.get("state"),
            "kind": status.get("kind"),
            "app": status.get("app"),
            "turn": t.get("turn") if whole(t.get("turn")) else 0,
        }

    def sync(self, terminals: list, seq: object) -> None:
        """A snapshot (the first line, or `missed`): the truth now. Changes since the last look alert as events do."""
        notify = self.synced
        seen: set[str] = set()
        for t in terminals:
            if not isinstance(t, dict) or not isinstance(t.get("address"), str):
                continue
            addr = t["address"]
            seen.add(addr)
            prev = self.terms.get(addr, {}).get("word")
            self.terms[addr] = self.record(t)
            alert = core_alert(prev, self.terms[addr]["word"])
            if notify and alert and self.terms[addr]["parent"] is None:
                self.raise_alert(addr, alert, turn_known=True)
        for gone in set(self.terms) - seen:
            self.forget(gone)
        self.synced = True
        if whole(seq):
            self.floor = seq

    def apply(self, params: dict) -> None:
        seq = params.get("seq")
        if whole(seq):
            if seq <= self.floor:
                return
            self.floor = seq
        kind = params.get("type")
        data = params.get("data") if isinstance(params.get("data"), dict) else {}
        addr = params.get("terminal")
        if not isinstance(addr, str):
            return
        if kind in ("created", "restarted"):
            # A machine whose line came back sends its changed terminals as created again.
            prev = self.terms[addr]["word"] if addr in self.terms else None
            self.terms[addr] = self.record(data)
            alert = core_alert(prev, self.terms[addr]["word"])
            if alert and self.terms[addr]["parent"] is None:
                self.raise_alert(addr, alert, turn_known=True)
        elif kind == "removed":
            self.forget(addr)
        elif addr not in self.terms:
            return
        elif kind == "status":
            term = self.terms[addr]
            status = data.get("status") if isinstance(data.get("status"), dict) else {}
            prev, term["word"] = term["word"], status.get("state")
            term["kind"], term["app"] = status.get("kind"), status.get("app") or term["app"]
            alert = core_alert(prev, term["word"])
            if alert and term["parent"] is None:
                self.raise_alert(addr, alert)
        elif kind == "turn":
            term = self.terms[addr]
            if whole(data.get("turn")):
                term["turn"] = data["turn"]
            pending = self.pending.get(addr)
            if pending:
                pending["turn"] = True
                if pending["alert"] == "blocked":
                    self.fire(addr, pending["token"])
        elif kind == "labels" and isinstance(data.get("labels"), dict):
            self.terms[addr]["labels"] = data["labels"]

    def forget(self, addr: str) -> None:
        self.terms.pop(addr, None)
        self.pending.pop(addr, None)
        for key in [k for k in self.last_push if k[0] == addr]:
            del self.last_push[key]

    # -- deciding to push

    def raise_alert(self, addr: str, alert: str, turn_known: bool = False) -> None:
        """A block waits for the turn event that follows its status (or [settle]); a finish waits for [seen_grace],
        and then, if its turn event is still missing, once more for [settle]: it is judged on its own turn."""
        self.token += 1
        token = self.token
        self.pending[addr] = {"token": token, "alert": alert, "turn": turn_known, "retried": False}
        if alert == "blocked" and turn_known:
            self.fire(addr, token)
            return
        self.schedule(self.settle if alert == "blocked" else self.seen_grace, lambda: self.timed(addr, token))

    def seen(self, term: dict) -> bool:
        """Nobody looked unless the shared label says someone saw this turn."""
        try:
            return int(term["labels"].get("herdr.seen")) >= term["turn"]
        except (TypeError, ValueError):
            return False

    def fire(self, addr: str, token: int) -> None:
        # Decides only; [flush] sends.
        with self.lock:
            pending = self.pending.get(addr)
            if not pending or pending["token"] != token:
                return
            alert = pending["alert"]
            term = self.terms.get(addr)
            if alert == "done" and not pending["turn"] and not pending["retried"]:
                pending["retried"] = True
                self.schedule(self.settle, lambda: self.timed(addr, token))
                return
            del self.pending[addr]
            # A remote machine's terminal ("rohan/t7") is that machine's watcher's to announce.
            if term is None or term["parent"] is not None or "/" in addr:
                return
            word = term["word"]
            if alert == "blocked":
                if word not in NEEDS:
                    return  # answered before we could say so
            elif word is None or word in BUSY or self.seen(term):
                return  # working again, or someone looked
            now = self.clock()
            key = (addr, alert, term["turn"])
            last = self.last_push.get(key)
            if last is not None and now - last < self.debounce:
                log(f"{addr} {alert}: debounced")
                return
            self.last_push[key] = now
            self.outbox.append((self.payload(addr, alert, term), f"{addr} {alert}"))

    def payload(self, addr: str, alert: str, term: dict) -> dict:
        where = term["labels"].get("where")
        space, sep, tab = where.partition(" / ") if isinstance(where, str) else ("", "", "")
        kind = term["kind"] if term["kind"] in CORE_KINDS else None
        app = term["app"] if isinstance(term["app"], str) else ""
        return {
            "v": 1,
            "event": "pane.agent_status_changed",
            "state": alert,
            "host": self.host,
            "session": CORE_SESSION,
            "pane_id": addr,
            "agent": app[:AGENT_MAX] or None,
            "kind": kind if alert == "blocked" else None,
            "turn": term["turn"],
            "workspace_id": None,
            "workspace": space or None,
            "tab_id": None,
            "tab": (tab if sep else None) or None,
            "ts": int(time.time()),
        }


class Sessions:
    """One Watcher thread per running Herdr session; [scan] starts the new ones."""

    def __init__(self, make: Callable[[str, str], Watcher], find: Callable[[], dict[str, str]] = herdr_sessions) -> None:
        self.make = make
        self.find = find
        self.threads: dict[str, threading.Thread] = {}

    def scan(self) -> None:
        for name, sock in self.find().items():
            thread = self.threads.get(name)
            if (thread is not None and thread.is_alive()) or not running(sock):
                continue
            log(f"session {name}: following {sock}")
            thread = threading.Thread(target=self.make(sock, name).run, name=f"watch-{name}", daemon=True)
            thread.start()
            self.threads[name] = thread

    def run(self) -> int:
        herdr = os.path.join(config_home(), "herdr")
        if not os.path.isdir(herdr):
            log(f"no Herdr here ({herdr} missing); nothing to watch")
            return 0
        while True:
            self.scan()
            time.sleep(RESCAN)


def make_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Push Herdr agent alerts to Mercurio.")
    parser.add_argument("--session", help="follow only this Herdr session (default: every running session)")
    parser.add_argument("--states", default="blocked", help="comma list of states to push (default: blocked)")
    parser.add_argument("--debounce", type=float, default=20.0, help="seconds between pushes for one pane")
    parser.add_argument("--endpoints", default=os.path.join(config_home(), "mercurio", "push-endpoints"))
    parser.add_argument("--core", action="store_true", help="also follow herdr-core (hc events); off by default")
    parser.add_argument("--hc", default="hc", help="the hc to run for --core (a user service may lack ~/.local/bin on PATH)")
    parser.add_argument("--seen-grace", type=float, default=CORE_SEEN_GRACE, help="seconds a core finish waits for a seen mark")
    return parser


def main(argv: list[str] | None = None) -> int:
    args = make_parser().parse_args(argv)
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    host = socket.gethostname()
    states = [s.strip() for s in args.states.split(",") if s.strip()]

    def make(sock_path: str, session: str) -> Watcher:
        return Watcher(sock_path, session, host, states, args.debounce, args.endpoints)

    core = None
    if args.core:
        watcher = CoreWatcher(
            host,
            args.endpoints,
            args.debounce,
            spawn=lambda: hc_lines([args.hc, *CORE_COMMAND[1:]]),
            seen_grace=args.seen_grace,
        )
        core = threading.Thread(target=watcher.run, name="watch-core", daemon=True)
        core.start()
        log("following herdr-core (hc events)")
    try:
        code = make(herdr_socket(args.session), args.session).run() if args.session else Sessions(make).run()
        if core is not None and code == 0:
            core.join()  # no Herdr TUI here (it returns 0 at once); the core watcher is the job
        return code
    except KeyboardInterrupt:
        return 0


if __name__ == "__main__":
    sys.exit(main())
