<?xml version="1.0" encoding="utf-8"?>
<!-- Key bar: his own paged keys after the bottom key row, edited in the settings panel. -->
<resources>
	<!-- Settings panel: the switch for the custom key bar -->
	<string name="key_bar_custom">Custom key bar</string>
	<string name="key_bar_custom_on">Swipe the bottom key row for your keys</string>
	<string name="key_bar_custom_off">Off: the compose bar stays as it is</string>
	<!-- Settings panel: opens the editor; %1$d is the number of keys, %2$d the number of pages -->
	<string name="key_bar_edit">Edit key bar</string>
	<string name="key_bar_edit_summary">%1$d keys in %2$d pages</string>
	<!-- Editor: page chip; %1$d is the page number -->
	<string name="key_bar_page">Page %1$d</string>
	<string name="key_bar_add_page">Add page</string>
	<!-- Editor: removes the page picked; %1$d is its number -->
	<string name="key_bar_remove_page">Remove page %1$d</string>
	<string name="key_bar_reset">Reset</string>
	<string name="key_bar_empty_page">No keys on this page. Add some below.</string>
	<string name="key_bar_add_key">Add a key</string>
	<!-- Editor: screen reader names for the row buttons; %1$s is the key -->
	<string name="key_bar_move_up">Move %1$s up</string>
	<string name="key_bar_move_down">Move %1$s down</string>
	<string name="key_bar_remove">Remove %1$s</string>
	<!-- Key bar: Ctrl and Alt state; %1$s is the key -->
	<string name="key_bar_modifier_armed">%1$s, armed for the next key</string>
	<string name="key_bar_modifier_locked">%1$s, locked</string>
	<!-- Key bar: the small Ctrl or Alt mark beside the page dots, read by TalkBack; %1$s is Ctrl or Alt -->
	<string name="key_bar_modifier_mark_armed">%1$s armed</string>
	<string name="key_bar_modifier_mark_locked">%1$s locked</string>
	<!-- Key bar: the Ctrl or Alt mark is a button that clears them; %1$s is the state, like "Ctrl locked" -->
	<string name="key_bar_modifier_mark_clear">%1$s, tap to clear</string>
	<!-- Key bar: a dot that goes to a page; %1$d is the page, %2$d the number of pages -->
	<string name="key_bar_page_dot">Page %1$d of %2$d</string>
	<!-- Editor: a key that types text he writes -->
	<string name="key_bar_custom_key">Custom key</string>
	<string name="key_bar_custom_key_hint">The key types this text, like /clear.</string>
	<string name="key_bar_custom_key_enter">Press Enter after the text</string>
	<string name="key_bar_page_full">This page is full</string>
	<string name="key_bar_reset_confirm">Reset the key bar to the default keys?</string>
</resources>
